# ============================================================
# 基础设施配置
# ============================================================
NACOS_SERVER_ADDR=nacos:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
# Nacos 3.x 控制台在容器 8080；映射到本机端口。若浏览器访问 8080 出现 “No static resource …”，可改为 18080 后重启：docker compose up -d nacos
# NACOS_CONSOLE_HOST_PORT=8080

MYSQL_HOST=mysql
MYSQL_PORT=3306

POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ============================================================
# central-account 服务配置
# ============================================================
DATASOURCE_URL=jdbc:mysql://mysql:3306/hojoai-central-account?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8
DATASOURCE_USERNAME=root
DATASOURCE_PASSWORD=

# ============================================================
# omniasst-account 服务配置
# ============================================================
OMNIASST_DATASOURCE_URL=jdbc:mysql://mysql:3306/hojoai-omniasst?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8
OMNIASST_DATASOURCE_USERNAME=root
OMNIASST_DATASOURCE_PASSWORD=
OMNIASST_REDIS_HOST=redis
OMNIASST_REDIS_PORT=6379
OMNIASST_REDIS_PASSWORD=
OMNIASST_REDIS_DATABASE=6
OMNIASST_POSTGRESQL_DATASOURCE_URL=jdbc:postgresql://postgres:5432/omniasst
OMNIASST_POSTGRESQL_DATASOURCE_USERNAME=omniasst
OMNIASST_POSTGRESQL_DATASOURCE_PASSWORD=devpass

